# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather

# LifePilot API
LIFEPILOT_API_URL=https://lifepilot.uz/api/v1

# Google Cloud
GOOGLE_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Database (same PostgreSQL as LifePilot)
DATABASE_URL=postgresql+asyncpg://postgres:lifepilot_prod_secret_2026@db:5432/productflow
REDIS_URL=redis://redis:6379/1

# Encryption key for JWT storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key

# Rate Limiting
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_PERIOD=60
RATE_LIMIT_AI_CALLS=100
RATE_LIMIT_AI_PERIOD=3600
