DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-use-long-random-string
DB_PASSWORD=productflow_secret
DB_NAME=productflow
DB_USER=postgres
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Core (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Resource Resolver (optional — works without them, just no clickable links)
YOUTUBE_API_KEY=
SERPER_API_KEY=

# Telegram Bot
BOT_TOKEN=

# Langfuse (optional — AI observability; leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
